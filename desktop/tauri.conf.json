{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "trellis-desktop",
  "identifier": "dev.trellis.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TRELLIS",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "description": "The main window: listen for the core's events and call its four commands.",
          "windows": ["main"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "allow-rpc-send",
            "allow-get-trails",
            "allow-open-repository",
            "allow-get-overview"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
