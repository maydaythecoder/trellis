{
  "about": "The rpc and log --json fields a client may rely on (ADR 0048 section 6, ADR 0025 sections 4 and 5), held by tests in tests/modes.rs. An event's fields are under its \"fields\" object, beside \"message\". A response's data, per command, is under \"responses\": the fields always in it, and those present only for one value of another. A response's id is the id its command was sent with, and a run's run_start and run_end carry the id of the prompt that started it. Fields not listed here are unversioned.",
  "rpc": {
    "events": {
      "turn": {
        "always": ["turn", "call", "verdict", "check_kind", "observation"],
        "blast_radius_only": ["resolved", "candidates", "unresolved"],
        "prompt_driver_only": ["prompt_bytes"],
        "verdict_values": ["None", "Some(true)", "Some(false)"]
      },
      "run budget": {
        "always": ["max_iterations"]
      },
      "steer delivered": {
        "always": ["after_step"]
      }
    },
    "framing": {
      "run_start": {
        "always": ["type", "version", "trellis", "task", "model", "root", "id"],
        "optional": {}
      },
      "run_end": {
        "always": ["type", "outcome", "exit", "id"],
        "optional": {
          "run_id": "when a trail was written",
          "restored": "when the outcome is not_converged or interrupted",
          "error": "when the outcome is error"
        }
      },
      "response": {
        "always": ["type", "command", "success", "id"],
        "optional": {
          "data": "when success is true and the command answers with data",
          "error": "when success is false"
        }
      },
      "approval_request": {
        "always": ["type", "id", "question", "detail"],
        "optional": {}
      }
    },
    "responses": {
      "classify": {
        "always": ["intent"],
        "question_only": ["answer"],
        "intent_values": ["question", "task"]
      }
    }
  },
  "log_json": {
    "always": [
      "run_id",
      "integrity",
      "outcome",
      "trail.task",
      "trail.started_at",
      "trail.factual.check_outcomes[].kind",
      "trail.factual.check_outcomes[].passed",
      "trail.factual.mode_counts.verified",
      "trail.factual.mode_counts.reviewed",
      "trail.judgment.tech_debt_projection",
      "trail.judgment.rationale"
    ],
    "optional": {
      "trail.factual.label": "when the session was named"
    }
  }
}
