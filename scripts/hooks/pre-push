#!/bin/sh
# Local stand-in for branch protection (GitHub refuses protection on a
# private repository without Pro). `main` is the launch branch and moves only
# when the owner merges a pull request from `dev` on GitHub; `v0.1-resolver`
# is the legacy default branch and stays frozen. This clone never pushes to
# either: no update, no force-push, no deletion. Ticket and feature branches
# merge into `audit`, which is promoted into `dev` (ADR 0051, amending 0036).
# Bypass deliberately with --no-verify.
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/v0.1-resolver)
      echo "pre-push: refusing to push to ${remote_ref#refs/heads/}; merge through a pull request on GitHub" >&2
      exit 1
      ;;
  esac
done
exit 0
