/target

# cargo-mutants working directory: a full copy of the tree per job, plus one
# log per mutant. Regenerated by `cargo mutants`; the results that matter are
# transcribed into CORRECTNESS_LEDGER.md and docs/bench/.
/mutants.out
/mutants.out.old

# cargo-llvm-cov profile data and reports.
/lcov.info
/coverage.json

# Benchmark corpora, fetched not vendored. See docs/bench/.
/.bench

# The built binary staged for `dist/QUICKSTART.md`. The instructions are
# tracked; a 30 MB executable is not.
/dist/trellis.exe
