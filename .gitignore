/target
**/*.rs.bk

# Derived state: regenerated from the file set, never merged.
# See docs/adr/0007-trail-format.md.
.trellis/index.bin
.trellis/work/

# Benchmark corpora: cloned, pinned by SHA in docs/BENCHMARK_AND_EVAL.md.
# Also holds the hand-audit working directories, which are inputs to the
# measurements in docs/bench/ rather than artifacts to commit.
.bench/

# cargo-mutants working directory: a full copy of the tree per job, plus one
# log per mutant. Regenerated by `cargo mutants`; the results that matter are
# transcribed into CORRECTNESS_LEDGER.md and docs/bench/.
/mutants.out
/mutants.out.old

# cargo-llvm-cov profile data and reports.
/lcov.info
/coverage.json

# The built binary staged for `dist/QUICKSTART.md`. The instructions are
# tracked; a 30 MB executable is not.
/dist/trellis.exe
